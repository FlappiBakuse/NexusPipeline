{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/execution-device-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "kind"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "kind": {
      "enum": [
        "configure",
        "connect",
        "connected",
        "features",
        "capture",
        "image",
        "click",
        "swipe",
        "touch",
        "key",
        "text",
        "scroll",
        "move",
        "inactive",
        "startApp",
        "stopApp",
        "shell"
      ]
    },
    "captureMethod": {
      "enum": [
        "printWindow",
        "gdi",
        "screenDc",
        "framePool",
        "adb"
      ]
    },
    "mouseMethod": {
      "enum": [
        "sendMessage",
        "postMessage",
        "sendMessageWithCursorPos",
        "seize",
        "adb"
      ]
    },
    "keyboardMethod": {
      "enum": [
        "sendMessage",
        "postMessage",
        "sendMessageWithCursorPos",
        "seize",
        "adb"
      ]
    },
    "x": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8191
    },
    "y": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8191
    },
    "x2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8191
    },
    "y2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8191
    },
    "durationMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000
    },
    "phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "contact": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "pressure": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "keyCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "text": {
      "type": "string",
      "maxLength": 4096
    },
    "dx": {
      "type": "integer",
      "minimum": -32767,
      "maximum": 32767
    },
    "dy": {
      "type": "integer",
      "minimum": -32767,
      "maximum": 32767
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "timeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "frameId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    }
  }
}
