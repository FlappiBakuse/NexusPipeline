{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/task-definitions.schema.json",
  "not": {},
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "state",
        "reasonCode"
      ],
      "properties": {
        "completedRepetitions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "state": {
          "enum": [
            "succeeded",
            "partial",
            "failed",
            "unknown"
          ]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "completionKind": {
          "enum": [
            "completed",
            "satisfied",
            "inapplicable",
            "notExecuted"
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "title",
        "isSelected",
        "isEnabled",
        "dependencies",
        "retrySafety"
      ],
      "properties": {
        "executionTaskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "repetitionLimit": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "isSelected": {
          "type": "boolean"
        },
        "isEnabled": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 256,
          "minItems": 0,
          "uniqueItems": true
        },
        "retrySafety": {
          "enum": [
            "safe",
            "unknown"
          ]
        },
        "workflowRole": {
          "enum": [
            "business",
            "technical",
            "cleanup"
          ]
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceId",
            "relativePath",
            "selector"
          ],
          "properties": {
            "resourceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "relativePath": {
              "type": "string",
              "maxLength": 1024
            },
            "selector": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "configuration-selector.schema.json#/$defs/step"
              }
            }
          }
        },
        "retryPrerequisites": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "nativeResumeScope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "titleLocales": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$",
            "maxLength": 35
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "sha256",
        "content"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "content": {
          "type": "string",
          "maxLength": 262144
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "relativePath": {
          "type": "string",
          "maxLength": 1024
        },
        "sourcePath": {
          "description": "Host-bound path relative to the selected script root, distinct from the configuration snapshot path; grants no file access.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "syntax": {
          "enum": [
            "opaque",
            "json",
            "jsonWithComments",
            "yaml"
          ]
        },
        "value": {
          "description": "Host-parsed semantics of the original SHA-bound content using its declared syntax; never an independent input authority."
        }
      }
    },
    "repetitionOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "completedRepetitions"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "completedRepetitions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        }
      }
    }
  }
}
