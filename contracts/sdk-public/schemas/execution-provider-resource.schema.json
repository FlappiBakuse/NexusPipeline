{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/execution-provider-resource.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resourceId",
    "declarationIndex",
    "definitionRevision"
  ],
  "properties": {
    "resourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "declarationIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "definitionRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
