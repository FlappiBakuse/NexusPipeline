{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/adapter-source-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries",
    "directories"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/relativePath"
      }
    },
    "directories": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/relativePath"
      }
    }
  }
}
