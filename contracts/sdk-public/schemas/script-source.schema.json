{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/script-source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "direction",
    "operationId",
    "extensionId"
  ],
  "properties": {
    "format": {
      "const": "nexus.script.source"
    },
    "version": {
      "const": 1
    },
    "direction": {
      "enum": [
        "request",
        "response"
      ]
    },
    "operationId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "extensionId": {
      "$ref": "common.schema.json#/$defs/extensionId"
    },
    "candidates": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]{1,120}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "direction": {
            "const": "request"
          }
        }
      },
      "then": {
        "properties": {
          "candidates": false,
          "diagnostics": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "direction": {
            "const": "response"
          }
        }
      },
      "then": {
        "required": [
          "candidates",
          "diagnostics"
        ]
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "title",
        "executable",
        "arguments",
        "resources",
        "logPaths"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "executable": {
          "$ref": "#/$defs/path"
        },
        "arguments": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "logPaths": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "exclusiveProgram": {
          "type": "boolean"
        },
        "projectSelection": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "path",
        "syntax"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "syntax": {
          "enum": [
            "json",
            "yaml"
          ]
        }
      }
    }
  }
}
