{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/notification-submission.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "invocation",
    "operationId",
    "notificationTaskIds",
    "title",
    "body"
  ],
  "properties": {
    "format": {
      "const": "nexus.notification.submission"
    },
    "version": {
      "const": 1
    },
    "invocation": {
      "$ref": "scheduled-invocation.schema.json"
    },
    "operationId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "notificationTaskIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 99,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  }
}
