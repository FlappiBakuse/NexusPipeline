{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/execution-plan.schema.json",
  "not": {},
  "$defs": {
    "interpreterImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sizeBytes",
        "sha256",
        "identity",
        "parentIdentity",
        "runtimeFiles"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32767
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "identity": {
          "$ref": "file-tree.schema.json#/$defs/physicalIdentity"
        },
        "parentIdentity": {
          "$ref": "file-tree.schema.json#/$defs/physicalIdentity"
        },
        "runtimeFiles": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/runtimeFile"
          }
        }
      }
    },
    "runtimeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "sizeBytes",
        "sha256",
        "identity",
        "parentIdentity"
      ],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "identity": {
          "$ref": "file-tree.schema.json#/$defs/physicalIdentity"
        },
        "parentIdentity": {
          "$ref": "file-tree.schema.json#/$defs/physicalIdentity"
        }
      }
    }
  }
}
