{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/scheduled-work-plans.schema.json",
  "title": "ScheduledWorkPlans",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "revision",
    "tasks"
  ],
  "properties": {
    "format": {
      "const": "nexus.schedule.work-plans"
    },
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tasks": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "revision",
        "isEnabled",
        "timeZoneId",
        "weekdays",
        "localMinute",
        "timeoutSeconds",
        "notificationTaskIds"
      ],
      "properties": {
        "taskId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "ownerTaskId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "isEnabled": {
          "type": "boolean"
        },
        "timeZoneId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "localMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "notificationTaskIds": {
          "type": "array",
          "maxItems": 99,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        }
      }
    }
  }
}
