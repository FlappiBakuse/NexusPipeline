{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/execution-device-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "kind",
    "success"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "kind": {
      "enum": [
        "configure",
        "connect",
        "connected",
        "features",
        "capture",
        "image",
        "click",
        "swipe",
        "touch",
        "key",
        "text",
        "scroll",
        "move",
        "inactive",
        "startApp",
        "stopApp",
        "shell"
      ]
    },
    "success": {
      "type": "boolean"
    },
    "features": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "frameId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "contentBase64": {
      "type": "string",
      "maxLength": 174764,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    }
  }
}
