{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/instance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "instanceId",
    "createdAt",
    "runtimeRoot"
  ],
  "properties": {
    "format": {
      "const": "nexus.instance"
    },
    "version": {
      "const": 1
    },
    "instanceId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/utcTime"
    },
    "runtimeRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}
