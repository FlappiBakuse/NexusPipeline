{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/run-attempt-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "instanceId",
    "operationId",
    "journalId",
    "runId",
    "attemptId",
    "attemptOrdinal",
    "executionPlan",
    "configurationPlans",
    "initialLogs",
    "outputDirectory",
    "logDirectory",
    "resourceKeys"
  ],
  "properties": {
    "format": {
      "const": "nexus.execution.run-attempt-plan"
    },
    "version": {
      "const": 1
    },
    "instanceId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "operationId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "journalId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "attemptId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "attemptOrdinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "executionPlan": {
      "$ref": "execution-plan.schema.json#/$defs/planReference"
    },
    "configurationPlans": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "plan"
        ],
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "plan": {
            "$ref": "execution-plan.schema.json#/$defs/planReference"
          }
        }
      }
    },
    "initialLogs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "parentIdentity",
          "before",
          "originalObjects"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 4,
            "maxLength": 32767
          },
          "parentIdentity": {
            "$ref": "file-tree.schema.json#/$defs/physicalIdentity"
          },
          "before": {
            "$ref": "file-tree.schema.json"
          },
          "originalObjects": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "$ref": "file-tree.schema.json#/$defs/physicalObject"
            }
          }
        }
      }
    },
    "outputDirectory": {
      "$ref": "common.schema.json#/$defs/relativePath"
    },
    "logDirectory": {
      "$ref": "common.schema.json#/$defs/relativePath"
    },
    "resourceKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "startRequest": {
      "$ref": "execution-plan.schema.json#/$defs/planReference"
    }
  }
}
