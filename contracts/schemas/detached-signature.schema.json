{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/detached-signature.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "keyId",
    "algorithm",
    "encoding",
    "signature"
  ],
  "properties": {
    "format": {
      "const": "nexus.detached.signature"
    },
    "version": {
      "const": 1
    },
    "keyId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$",
      "maxLength": 80
    },
    "algorithm": {
      "const": "ecdsa-p256-sha256"
    },
    "encoding": {
      "const": "base64-p1363"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  }
}
