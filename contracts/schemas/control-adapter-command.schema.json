{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/control-adapter-command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "action",
    "selection"
  ],
  "properties": {
    "format": {
      "const": "nexus.control.adapter-command"
    },
    "version": {
      "const": 1
    },
    "action": {
      "enum": [
        "discover",
        "propose",
        "previewRepair",
        "applyRepair"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "bindingId",
        "expectedBindingRevision",
        "extensionId",
        "expectedInstalledRevision",
        "resources"
      ],
      "properties": {
        "operationId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "bindingId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "expectedBindingRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "extensionId": {
          "$ref": "common.schema.json#/$defs/extensionId"
        },
        "expectedInstalledRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "resources": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resourceId",
              "expectedRevision",
              "relativePath"
            ],
            "properties": {
              "resourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "expectedRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "relativePath": {
                "type": "string",
                "maxLength": 1024
              }
            }
          }
        },
        "configurationIntents": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "config-patch.schema.json" }
        }
      }
    },
    "candidateIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "proposalDigest": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "previewRepair",
              "applyRepair"
            ]
          }
        }
      },
      "then": {
        "required": [
          "candidateIndex",
          "proposalDigest"
        ]
      },
      "else": {
        "properties": {
          "candidateIndex": false,
          "proposalDigest": false
        }
      }
    }
  ]
}
