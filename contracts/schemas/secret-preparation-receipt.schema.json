{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/secret-preparation-receipt.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "version", "instanceId", "operationId", "journalId", "writerId", "planDigest", "stage", "candidate", "parentIdentity"],
  "properties": {
    "format": {"const": "nexus.secret.preparation.receipt"},
    "version": {"const": 1},
    "instanceId": {"$ref": "common.schema.json#/$defs/uuid"},
    "operationId": {"$ref": "common.schema.json#/$defs/uuid"},
    "journalId": {"$ref": "common.schema.json#/$defs/uuid"},
    "writerId": {"$ref": "common.schema.json#/$defs/uuid"},
    "planDigest": {"$ref": "common.schema.json#/$defs/sha256"},
    "stage": {"enum": ["started", "completed"]},
    "candidate": {"$ref": "secret-preparation-defs.schema.json#/$defs/candidate"},
    "parentIdentity": {"$ref": "file-tree.schema.json#/$defs/physicalIdentity"},
    "identity": {"$ref": "file-tree.schema.json#/$defs/physicalIdentity"}
  },
  "allOf": [
    {"if": {"properties": {"stage": {"const": "completed"}}},
      "then": {"required": ["identity"]}, "else": {"properties": {"identity": false}}}
  ]
}
