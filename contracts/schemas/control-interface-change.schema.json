{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/control-interface-change.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "operationId",
    "expectedRevision",
    "values"
  ],
  "properties": {
    "format": {
      "const": "nexus.control.interface-change"
    },
    "version": {
      "const": 1
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "dashboardCards",
        "pinnedSettings",
        "collapsedSettings",
        "locale"
      ],
      "properties": {
        "theme": {
          "enum": [
            "dark",
            "light",
            "system"
          ]
        },
        "dashboardCards": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,95}$"
          }
        },
        "pinnedSettings": {
          "$ref": "#/$defs/settings"
        },
        "collapsedSettings": {
          "$ref": "#/$defs/settings"
        },
        "locale": {
          "enum": [
            "zh-CN",
            "en-US"
          ]
        }
      }
    }
  },
  "$defs": {
    "settings": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(service|remote|proxy|advanced|updates|diagnostics|extension:[a-z0-9-]{1,80}:[a-z0-9-]{1,40})$"
      }
    }
  }
}
