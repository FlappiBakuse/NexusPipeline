{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/control-native-editor.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "sessionId",
    "bindingId",
    "expectedBindingRevision",
    "expectedScriptRevision",
    "editorRootId",
    "expectedEditorRootRevision",
    "editorRelativePath",
    "arguments",
    "resources"
  ],
  "properties": {
    "format": {
      "const": "nexus.control.native-editor"
    },
    "version": {
      "const": 1
    },
    "sessionId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "bindingId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "expectedBindingRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedScriptRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "editorRootId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "expectedEditorRootRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "editorRelativePath": {
      "$ref": "common.schema.json#/$defs/relativePath"
    },
    "arguments": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 32767
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resourceId",
          "expectedRevision"
        ],
        "properties": {
          "resourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740990
          }
        }
      }
    }
  }
}
