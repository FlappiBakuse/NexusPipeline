{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/asset-preparation-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "instanceId", "operationId", "journalId", "operationKind", "input", "expectedCatalogRevision", "previewDigest", "workspaceParentIdentity", "roots", "assets", "resourceKeys"],
  "properties": {
    "format": {"const": "nexus.asset.preparation-plan"},
    "version": {"const": 1},
    "instanceId": {"$ref": "common.schema.json#/$defs/uuid"},
    "operationId": {"$ref": "common.schema.json#/$defs/uuid"},
    "journalId": {"$ref": "common.schema.json#/$defs/uuid"},
    "operationKind": {"const": "assetPrepare"},
    "input": {"$ref": "asset-preparation-defs.schema.json#/$defs/blob"},
    "expectedCatalogRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "previewDigest": {"$ref": "common.schema.json#/$defs/sha256"},
    "workspaceParentIdentity": {"$ref": "file-tree.schema.json#/$defs/physicalIdentity"},
    "roots": {"type": "array", "maxItems": 128, "items": {"$ref": "asset-preparation-defs.schema.json#/$defs/root"}},
    "assets": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "asset-preparation-defs.schema.json#/$defs/asset"}},
    "resourceKeys": {
      "type": "array", "minItems": 1, "maxItems": 257, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    }
  }
}
