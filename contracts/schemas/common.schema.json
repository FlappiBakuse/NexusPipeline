{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/common.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "releaseVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:beta|rc)\\.[1-9][0-9]*)?$"
    },
    "utcTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "extensionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "artifactName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 100
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\])[A-Za-z0-9_.@/-]+$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "url": {
          "$ref": "common.schema.json#/$defs/httpsUrl"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
