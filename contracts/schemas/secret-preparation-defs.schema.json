{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/secret-preparation-defs.schema.json",
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretId",
        "protectionScheme",
        "ownerSid",
        "relativePath",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "secretId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "protectionScheme": {
          "const": "windows-user-dpapi-utf8-v1"
        },
        "ownerSid": {
          "type": "string",
          "pattern": "^S-1-[0-9]+(?:-[0-9]+)+$",
          "maxLength": 184
        },
        "relativePath": {
          "type": "string",
          "pattern": "^secrets/payloads/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}-[0-9a-f]{64}\\.bin$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "none",
            "planned",
            "unverified"
          ]
        },
        "journalId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "plan": {
          "$ref": "asset-preparation-defs.schema.json#/$defs/blob"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "planned"
              }
            }
          },
          "then": {
            "required": [
              "journalId",
              "plan"
            ]
          },
          "else": {
            "properties": {
              "journalId": false,
              "plan": false
            }
          }
        }
      ]
    },
    "notificationPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentOperationId",
        "parentRequestDigest",
        "ciphertext"
      ],
      "properties": {
        "parentOperationId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "parentRequestDigest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "ciphertext": {
          "$ref": "asset-preparation-defs.schema.json#/$defs/blob"
        }
      }
    }
  }
}
