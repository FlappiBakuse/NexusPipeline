{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/control-extension-reconcile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extensionId",
    "expectedInstalledRevision",
    "expectedSettingsRevision"
  ],
  "properties": {
    "extensionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "expectedInstalledRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedSettingsRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
