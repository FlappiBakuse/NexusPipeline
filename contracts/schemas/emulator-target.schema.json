{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/emulator-target.schema.json",
  "$defs": {
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["vendor", "rootId", "targetId", "generation"],
      "properties": {
        "vendor": {"enum": ["ldplayer", "nox", "bluestacks"]},
        "rootId": {"$ref": "common.schema.json#/$defs/uuid"},
        "targetId": {"$ref": "common.schema.json#/$defs/sha256"},
        "generation": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["arguments", "detached"],
      "properties": {
        "arguments": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "detached": {"type": "boolean"}
      }
    },
    "frozen": {
      "type": "object", "additionalProperties": false,
      "required": ["selection", "extensionId", "providerId", "installedRevision", "packageSha256", "activationId", "installationId",
        "instanceDirectory", "instancePhysicalId", "control", "launch", "sourceEvidence"],
      "properties": {
        "selection": {"$ref": "#/$defs/selection"},
        "extensionId": {"const": "emulator-support"},
        "providerId": {"const": "vendors"},
        "installedRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "packageSha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "activationId": {"$ref": "common.schema.json#/$defs/uuid"},
        "installationId": {"type": "string", "pattern": "^install:[0-9a-f]{64}$"},
        "instanceDirectory": {"type": "string", "minLength": 4, "maxLength": 32767},
        "instancePhysicalId": {"$ref": "file-tree.schema.json#/$defs/physicalIdentity"},
        "control": {"$ref": "execution-plan.schema.json#/$defs/interpreterImage"},
        "launch": {"$ref": "#/$defs/command"},
        "quit": {"$ref": "#/$defs/command"},
        "sourceEvidence": {"$ref": "execution-plan.schema.json#/$defs/planReference"}
      }
    }
  }
}
