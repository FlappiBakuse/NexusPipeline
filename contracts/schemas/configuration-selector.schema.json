{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/configuration-selector.schema.json",
  "$ref": "#/$defs/selector",
  "$defs": {
    "step": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 256},
        {"type": "integer", "minimum": 0},
        {
          "type": "object", "additionalProperties": false, "required": ["match"],
          "properties": {
            "match": {
              "type": "object", "additionalProperties": false, "required": ["property", "value"],
              "properties": {
                "property": {"type": "string", "minLength": 1, "maxLength": 256},
                "value": {"type": "string", "minLength": 1, "maxLength": 256}
              }
            }
          }
        }
      ]
    },
    "selector": {"type": "array", "items": {"$ref": "#/$defs/step"}, "maxItems": 64},
    "grant": {
      "type": "object", "additionalProperties": false, "required": ["selector", "descendants"],
      "properties": {"selector": {"$ref": "#/$defs/selector"}, "descendants": {"type": "boolean"}}
    },
    "access": {
      "type": "object", "additionalProperties": false, "required": ["read", "write", "protected"],
      "properties": {
        "read": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/grant"}},
        "write": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/grant"}},
        "protected": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/selector"}}
      }
    }
  }
}
