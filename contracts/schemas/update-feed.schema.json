{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/update-feed.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "channel",
    "sequence",
    "releases"
  ],
  "properties": {
    "format": {
      "const": "nexus.update.feed"
    },
    "version": {
      "const": 1
    },
    "channel": {
      "enum": [
        "stable",
        "prerelease"
      ]
    },
    "sequence": {
      "$ref": "common.schema.json#/$defs/sequence"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostVersion",
          "minReaderVersion",
          "artifact",
          "payloadManifestSha256",
          "publishedAt",
          "storeBinding",
          "releaseId",
          "assetId"
        ],
        "properties": {
          "hostVersion": {
            "$ref": "common.schema.json#/$defs/releaseVersion"
          },
          "minReaderVersion": {
            "$ref": "common.schema.json#/$defs/releaseVersion"
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "sizeBytes",
              "sha256"
            ],
            "properties": {
              "url": {
                "$ref": "common.schema.json#/$defs/httpsUrl"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1073741824
              },
              "sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              }
            }
          },
          "payloadManifestSha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "publishedAt": {
            "$ref": "common.schema.json#/$defs/utcTime"
          },
          "storeBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "generationId",
              "sequence",
              "catalogUrl",
              "catalogSha256",
              "signatureUrl"
            ],
            "properties": {
              "channel": {
                "enum": [
                  "stable",
                  "develop"
                ]
              },
              "generationId": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "sequence": {
                "$ref": "common.schema.json#/$defs/sequence"
              },
              "catalogUrl": {
                "$ref": "common.schema.json#/$defs/httpsUrl"
              },
              "catalogSha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "signatureUrl": {
                "$ref": "common.schema.json#/$defs/httpsUrl"
              }
            }
          },
          "releaseId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "assetId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    }
  }
}
