{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/control-extension-apply.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "operationId",
    "command"
  ],
  "properties": {
    "format": {
      "const": "nexus.control.extension-apply"
    },
    "version": {
      "const": 1
    },
    "operationId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "extensionId",
        "expectedInstalledRevision",
        "expectedSettingsRevision",
        "catalog",
        "candidate"
      ],
      "properties": {
        "action": {
          "enum": [
            "install",
            "upgrade",
            "remove"
          ]
        },
        "extensionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "expectedInstalledRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedSettingsRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "catalog": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "channel",
                "generationId",
                "sequence",
                "sha256"
              ],
              "properties": {
                "channel": {
                  "enum": [
                    "stable",
                    "develop"
                  ]
                },
                "generationId": {
                  "$ref": "common.schema.json#/$defs/uuid"
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "$ref": "common.schema.json#/$defs/sha256"
                }
              }
            }
          ]
        },
        "candidate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "extensionId",
                "artifactName",
                "packageVersion",
                "kind",
                "minHostVersion",
                "sdkVersion",
                "artifactUrl",
                "artifactBytes",
                "artifactSha256",
                "manifestSha256"
              ],
              "properties": {
                "extensionId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,79}$"
                },
                "artifactName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "packageVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "kind": {
                  "enum": [
                    "managed-code",
                    "data-specialized"
                  ]
                },
                "minHostVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sdkVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "artifactUrl": {
                  "type": "string",
                  "maxLength": 2048
                },
                "artifactBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1073741824
                },
                "artifactSha256": {
                  "$ref": "common.schema.json#/$defs/sha256"
                },
                "manifestSha256": {
                  "$ref": "common.schema.json#/$defs/sha256"
                },
                "metadata": {
                  "$ref": "extension-metadata.schema.json"
                }
              }
            }
          ]
        }
      }
    }
  }
}
