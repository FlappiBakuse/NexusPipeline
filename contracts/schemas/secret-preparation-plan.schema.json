{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/secret-preparation-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "instanceId",
    "operationId",
    "journalId",
    "operationKind",
    "ownerKind",
    "subjectId",
    "field",
    "expectedRevision",
    "candidate",
    "replayProof",
    "payloadParentIdentity",
    "receiptParentIdentity",
    "retirement",
    "resourceKeys"
  ],
  "properties": {
    "format": {
      "const": "nexus.secret.preparation-plan"
    },
    "version": {
      "const": 1
    },
    "instanceId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "operationId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "journalId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "operationKind": {
      "const": "secretPrepare"
    },
    "ownerKind": {
      "enum": [
        "extension",
        "host",
        "notificationTask"
      ]
    },
    "extensionId": {
      "$ref": "common.schema.json#/$defs/extensionId"
    },
    "subjectId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "field": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,80}$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "beforeSecretId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "candidate": {
      "$ref": "secret-preparation-defs.schema.json#/$defs/candidate"
    },
    "replayProof": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "payloadParentIdentity": {
      "$ref": "file-tree.schema.json#/$defs/physicalIdentity"
    },
    "receiptParentIdentity": {
      "$ref": "file-tree.schema.json#/$defs/physicalIdentity"
    },
    "retirement": {
      "$ref": "secret-preparation-defs.schema.json#/$defs/retirement"
    },
    "resourceKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:secrets:fields|extension-data:[a-z0-9-]{1,80})$"
      }
    },
    "notificationPublication": {
      "$ref": "secret-preparation-defs.schema.json#/$defs/notificationPublication"
    },
    "documentPublication": {
      "$ref": "secret-preparation-defs.schema.json#/$defs/notificationPublication"
    }
  },
  "oneOf": [
    {
      "properties": {
        "ownerKind": {
          "const": "extension"
        },
        "notificationPublication": false
      },
      "required": [
        "extensionId"
      ]
    },
    {
      "properties": {
        "ownerKind": {
          "const": "host"
        },
        "field": {
          "enum": [
            "proxy-password",
            "control-bearer"
          ]
        },
        "notificationPublication": false,
        "documentPublication": false
      },
      "not": {
        "required": [
          "extensionId"
        ]
      }
    },
    {
      "properties": {
        "ownerKind": {
          "const": "notificationTask"
        },
        "documentPublication": false,
        "field": {
          "enum": [
            "webhook-url",
            "webhook-secret",
            "feishu-app-secret",
            "slack-bot-token",
            "smtp-password"
          ]
        }
      },
      "required": [
        "notificationPublication"
      ],
      "not": {
        "required": [
          "extensionId"
        ]
      }
    }
  ]
}
