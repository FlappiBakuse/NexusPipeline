{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/browser-login-policy.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["id", "startUrl", "origins", "popupOrigins", "cookies", "storage", "jsonRequests", "readySets", "checks", "equalSets"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "startUrl": {"type": "string", "minLength": 1, "maxLength": 2048},
    "origins": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/origin"}},
    "popupOrigins": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/origin"}},
    "cookies": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/cookie"}},
    "storage": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/storage"}},
    "jsonRequests": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/jsonRequest"}},
    "readySets": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/set"}},
    "checks": {"type": "array", "maxItems": 28, "items": {"$ref": "#/$defs/check"}},
    "equalSets": {"type": "array", "maxItems": 8, "items": {"type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9._-]+$"},
    "origin": {"type": "string", "minLength": 1, "maxLength": 2048},
    "set": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "path": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "cookie": {
      "type": "object", "additionalProperties": false, "required": ["id", "domain", "path", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "domain": {"type": "string", "minLength": 1, "maxLength": 253},
        "path": {"type": "string", "minLength": 1, "maxLength": 256}, "name": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["id", "origin", "storage", "key"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "origin": {"$ref": "#/$defs/origin"},
        "storage": {"enum": ["localStorage", "sessionStorage"]}, "key": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "jsonRequest": {
      "type": "object", "additionalProperties": false, "required": ["id", "origin", "endpoint", "method", "selector"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "origin": {"$ref": "#/$defs/origin"}, "endpoint": {"type": "string", "minLength": 1, "maxLength": 2048},
        "method": {"enum": ["GET", "POST"]}, "selector": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "maximumLength"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["nonEmpty", "cookie", "header", "token", "digits"]},
        "path": {"$ref": "#/$defs/path"}, "maximumLength": {"type": "integer", "minimum": 1, "maximum": 32768}
      }
    }
  }
}
