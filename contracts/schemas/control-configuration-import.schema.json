{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/control-configuration-import.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "operationId", "bindingId", "expectedBindingRevision", "expectedScriptRevision", "resources"],
  "properties": {
    "format": { "const": "nexus.control.configuration-import" },
    "version": { "const": 1 },
    "operationId": { "$ref": "common.schema.json#/$defs/uuid" },
    "bindingId": { "$ref": "common.schema.json#/$defs/uuid" },
    "expectedBindingRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "expectedScriptRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "resources": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["resourceId", "expectedRevision"],
        "properties": {
          "resourceId": { "type": "string", "minLength": 1, "maxLength": 120 },
          "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 }
        }
      }
    }
  }
}
