{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/automation-binding-source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidateId",
    "rootId",
    "executable",
    "arguments",
    "configurationPaths",
    "logPaths"
  ],
  "properties": {
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "rootId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "executable": {
      "$ref": "automation-paths.schema.json#/$defs/portablePath"
    },
    "arguments": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "configurationPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "items": {
        "$ref": "automation-paths.schema.json#/$defs/portablePath"
      }
    },
    "logPaths": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "automation-paths.schema.json#/$defs/portablePath"
      }
    }
  }
}
