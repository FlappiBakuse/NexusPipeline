{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/configuration-edit-output-reference.schema.json",
  "type": "object", "additionalProperties": false, "required": ["format", "version", "path", "sizeBytes", "sha256"],
  "properties": {
    "format": {"const": "nexus.configuration.edit-output-reference"}, "version": {"const": 1},
    "path": {"type": "string", "pattern": "^blobs/plans/[0-9a-f]{64}\\.json$"},
    "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
    "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
