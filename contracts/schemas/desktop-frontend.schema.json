{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexuspipeline.invalid/1/desktop-frontend.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "instanceId", "nativeClientId", "sessionId", "correlationId", "frontendClientId"],
  "properties": {
    "format": {"const": "nexus.desktop.frontend"},
    "version": {"const": 1},
    "instanceId": {"$ref": "common.schema.json#/$defs/uuid"},
    "nativeClientId": {"$ref": "common.schema.json#/$defs/uuid"},
    "sessionId": {"$ref": "common.schema.json#/$defs/uuid"},
    "correlationId": {"$ref": "common.schema.json#/$defs/uuid"},
    "frontendClientId": {"$ref": "common.schema.json#/$defs/uuid"}
  }
}
