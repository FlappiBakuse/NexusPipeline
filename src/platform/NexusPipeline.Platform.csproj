<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NexusPipeline.StorageTests" />
    <InternalsVisibleTo Include="NexusPipeline.StorageDataTests" />
    <InternalsVisibleTo Include="NexusPipeline.ContractTests" />
    <InternalsVisibleTo Include="NexusPipeline.WindowsTests" />
    <InternalsVisibleTo Include="OwnedWriter" />
    <InternalsVisibleTo Include="NexusPipeline.Host" />
    <InternalsVisibleTo Include="NexusPipeline.Installer" />
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <EmbeddedResource Include="../../contracts/schemas/*.schema.json" LogicalName="Contracts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Storage/Sqlite/StateSchema.sql" LogicalName="Storage.StateSchema.sql" />
    <EmbeddedResource Include="Security/release-trust.json" LogicalName="Security.ReleaseTrust.json" />
    <ProjectReference Include="../core/NexusPipeline.Core.csproj" />
    <ProjectReference Include="../../sdk/dotnet/NexusPipeline.Extensibility.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(NexusTestHost)' == 'true'">
    <Compile Include="../../tests/fixtures/InstallerTestPaths.cs" Link="Installation/InstallerTestPaths.cs" />
    <Compile Include="../../tests/fixtures/HostUpdateTrust.cs" Link="Maintenance/HostUpdateTrust.cs" />
    <Compile Include="../../tests/fixtures/ExtensionTestTrust.cs" Link="Extensions/ExtensionTestTrust.cs" />
  </ItemGroup>
