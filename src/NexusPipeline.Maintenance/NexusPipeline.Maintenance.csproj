<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>0.17.5</Version><NexusGenerateInstallationGeneration>true</NexusGenerateInstallationGeneration>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NexusTestHost)' == 'true'"><DefineConstants>$(DefineConstants);NEXUS_TEST_HOST</DefineConstants></PropertyGroup>
  <ItemGroup Condition="'$(NexusTestHost)' == 'true'">
    <Compile Include="../../tests/host/TestHostTransport.cs" Link="Testing/TestHostTransport.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <InternalsVisibleTo Include="NexusPipeline" />
    <InternalsVisibleTo Include="NexusPipeline.update" />
    <InternalsVisibleTo Include="NexusPipeline.uninstall" />
    <InternalsVisibleTo Include="nxp-metadata-helper" />
    <InternalsVisibleTo Include="NexusPipeline.Tests" />
    <InternalsVisibleTo Include="NexusPipeline.TestProviderWorker" />
    <InternalsVisibleTo Include="NexusPipeline.UpdateTests" />
    <InternalsVisibleTo Include="NexusPipeline.TaskProtocolTests" />
    <InternalsVisibleTo Include="NexusPipeline.StressDiagnostics" />
  </ItemGroup>
</Project>
