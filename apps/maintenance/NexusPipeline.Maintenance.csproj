<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>../desktop/nexuspipeline.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <ApplicationManifest Condition="'$(NexusTestHost)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(NexusTestHost)' == 'true'">test.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="NexusPipeline.Platform.Serialization.Protocol" />
    <Compile Include="../../src/platform/Storage/Maintenance/UpdateWindowPipe.cs" Link="UpdateWindowPipe.cs" />
    <AssemblyMetadata Include="Nexus.HostSha256" Value="$(NexusHostSha256)" />
  </ItemGroup>
</Project>
