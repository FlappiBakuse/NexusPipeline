{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "skipLibCheck": true, "useDefineForClassFields": true,
    "paths": { "@nexuspipeline/extension-sdk": ["../../sdk/frontend/src/index.ts"] }
