<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.18.0</Version>
    <LangVersion>14.0</LangVersion>
    <DefineConstants Condition="'$(NexusTestHost)' == 'true'">$(DefineConstants);NEXUS_TEST_HOST</DefineConstants>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(NexusArtifactsRoot)</ArtifactsPath>
    <RestorePackagesPath>$(NexusPackagesRoot)</RestorePackagesPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(NexusArtifactsRoot)/locks/$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="Exists('$(MSBuildProjectDirectory)/packages.lock.json')">$(MSBuildProjectDirectory)/packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode Condition="Exists('$(MSBuildProjectDirectory)/packages.lock.json')">true</RestoreLockedMode>
    <NuGetLockFilePath Condition="'$(NexusLockOutputRoot)' != ''">$(NexusLockOutputRoot)/$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'NexusPipeline.Platform' Or '$(MSBuildProjectName)' == 'NexusPipeline.Host' Or '$(MSBuildProjectName)' == 'NexusPipeline.Maintenance' Or '$(MSBuildProjectName)' == 'NexusPipeline.ContractTests' Or '$(MSBuildProjectName)' == 'NexusPipeline.StorageTests' Or '$(MSBuildProjectName)' == 'NexusPipeline.WindowsTests' Or '$(MSBuildProjectName)' == 'OwnedWriter'">
    <Using Include="NexusPipeline.Platform.Serialization.Protocol" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'NexusPipeline.Host' Or '$(MSBuildProjectName)' == 'NexusPipeline.Launcher' Or '$(MSBuildProjectName)' == 'NexusPipeline.Maintenance' Or '$(MSBuildProjectName)' == 'NexusPipeline.Installer'">
    <AssemblyMetadata Include="Nexus.BuildProfile" Value="production" Condition="'$(NexusTestHost)' != 'true'" />
    <AssemblyMetadata Include="Nexus.BuildProfile" Value="test" Condition="'$(NexusTestHost)' == 'true'" />
  </ItemGroup>
</Project>
