<Project>
  <PropertyGroup>
    <NexusInstallationGeneration>g0170</NexusInstallationGeneration>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RollForward>LatestPatch</RollForward>
  </PropertyGroup>
  <Target Name="GenerateInstallationGeneration" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'NexusPipeline' or '$(NexusGenerateInstallationGeneration)' == 'true'">
    <PropertyGroup>
      <_GenerationSource>$(IntermediateOutputPath)InstallationGeneration.g.cs</_GenerationSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(_GenerationSource)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="namespace NexusPipeline.Platform.Storage { internal static class InstallationGeneration { internal const string Id = &quot;$(NexusInstallationGeneration)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(_GenerationSource)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.AspNetCore.App" RuntimeFrameworkVersion="10.0.12" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Keep every project from re-including another project's generated obj/bin files. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Keep the Test Host restore/intermediate graph separate from production for every SDK project. -->
  <PropertyGroup Condition="'$(NexusTestHost)' == 'true'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\test-host\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\test-host\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>

  <!-- Keep Roslyn's production architecture graph independent per project; a global
       extensions path would make the Host and SDK overwrite each other's assets. -->
  <PropertyGroup Condition="'$(NexusArchitectureMode)' == 'production' and '$(NexusTestHost)' != 'true'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\architecture\production\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\architecture\production\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
